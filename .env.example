# copie para .env e preencha
# use uma chave aleatória com pelo menos 32 caracteres (o boot falha com DEBUG=0 se for a padrão)
SECRET_KEY=troque-por-uma-string-longa-e-aleatoria
DEBUG=0
# domínio público (o Caddy emite o HTTPS sozinho; o DNS precisa apontar para a VPS)
DOMINIO=seudominio.com.br
ALLOWED_HOSTS=seudominio.com.br
CSRF_TRUSTED_ORIGINS=https://seudominio.com.br
# desenvolvimento no celular: http://192.168.1.110:5173
FRONTEND_URL=https://seudominio.com.br
POSTGRES_PASSWORD=troque-esta-senha

# Senha do painel secreto de personalização (opcional). Gere com:
#   docker compose exec backend python manage.py gerar_senha_tema
# Sem esta variável o painel fica desativado.
PAINEL_TEMA_SENHA_HASH=
